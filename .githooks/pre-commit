#!/bin/bash
# Pre-commit hook: Validate Copilot configuration and repository integrity
# Prevents commits with configuration errors, secrets, or integrity issues

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXIT_CODE=0

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit validations..."
echo

# 1. Validate Copilot configuration
echo "📋 Validating Copilot configuration..."
if python3 "$REPO_ROOT/scripts/validate_copilot_config.py" > /tmp/copilot_validation.txt 2>&1; then
    echo -e "${GREEN}✓ Copilot configuration is valid${NC}"
else
    echo -e "${RED}✗ Copilot configuration validation failed:${NC}"
    cat /tmp/copilot_validation.txt
    EXIT_CODE=1
fi
echo

# 2. Check for secrets and sensitive patterns
echo "🔐 Checking for secrets and sensitive patterns..."
SECRETS_FOUND=0

# Patterns to detect
PATTERNS=(
    "password\s*=\s*['\"].*['\"]"
    "api[_-]?key\s*=\s*['\"].*['\"]"
    "secret\s*=\s*['\"].*['\"]"
    "token\s*=\s*['\"].*['\"]"
    "aws_access_key"
    "private[_-]?key"
)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")

if [[ -n "$STAGED_FILES" ]]; then
    for file in $STAGED_FILES; do
        # Skip binary files and certain types
        if [[ "$file" =~ \.(bin|lock|jpg|png|gif|zip|exe)$ ]]; then
            continue
        fi
        
        # Check each pattern
        for pattern in "${PATTERNS[@]}"; do
            if git show :"$file" 2>/dev/null | grep -iE "$pattern" > /dev/null 2>&1; then
                echo -e "${RED}⚠ Potential secret in $file: $pattern${NC}"
                SECRETS_FOUND=1
            fi
        done
    done
fi

if [[ $SECRETS_FOUND -eq 0 ]]; then
    echo -e "${GREEN}✓ No secrets detected${NC}"
else
    echo -e "${RED}✗ Potential secrets found. Review before committing.${NC}"
    EXIT_CODE=1
fi
echo

# 3. Verify critical files integrity (if modified)
echo "📁 Checking critical files integrity..."
CRITICAL_FILES=(
    ".github/copilot-instructions.md"
    "AGENTS.md"
    ".vscode/mcp.json"
    ".vscode/settings.json"
)

for file in "${CRITICAL_FILES[@]}"; do
    if git diff --cached --name-only | grep -q "^$file$"; then
        if [[ "$file" == *.json ]]; then
            if git show :"$file" 2>/dev/null | python3 -m json.tool > /dev/null 2>&1; then
                echo -e "${GREEN}✓ $file has valid JSON${NC}"
            else
                echo -e "${RED}✗ $file has invalid JSON${NC}"
                EXIT_CODE=1
            fi
        fi
    fi
done
echo

# 4. Check for common issues in instruction/skill files
echo "📚 Validating instruction and skill files..."
INSTRUCTION_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E "\.instructions\.md$|/SKILL\.md$" || echo "")

if [[ -n "$INSTRUCTION_FILES" ]]; then
    for file in $INSTRUCTION_FILES; do
        # Check for YAML frontmatter
        if ! git show :"$file" 2>/dev/null | head -1 | grep -q "^---$"; then
            echo -e "${RED}✗ $file missing YAML frontmatter start${NC}"
            EXIT_CODE=1
        elif ! git show :"$file" 2>/dev/null | head -5 | grep -q "^---$"; then
            echo -e "${RED}✗ $file missing YAML frontmatter end${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ $file has valid frontmatter${NC}"
        fi
    done
fi
echo

# 5. Warn about large files
echo "📦 Checking file sizes..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | while read file; do
    size=$(git show :"$file" 2>/dev/null | wc -c)
    if [[ $size -gt 1000000 ]]; then  # 1MB
        echo "$file ($(( size / 1024 / 1024 ))MB)"
    fi
done)

if [[ -n "$LARGE_FILES" ]]; then
    echo -e "${YELLOW}⚠ Large files detected:${NC}"
    echo "$LARGE_FILES"
    echo -e "${YELLOW}Consider using Git LFS or splitting changes${NC}"
else
    echo -e "${GREEN}✓ File sizes are reasonable${NC}"
fi
echo

# Summary
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ $EXIT_CODE -eq 0 ]]; then
    echo -e "${GREEN}✓ Pre-commit validation passed${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
else
    echo -e "${RED}✗ Pre-commit validation failed${NC}"
    echo -e "${YELLOW}Fix the issues above before committing${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
fi

exit $EXIT_CODE
